[Unit]
Description=Collect multi-source Red Bank forecast for weather.mhpwebserver.com
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=matt
WorkingDirectory=/home/matt/weather-redbank
ExecStart=/home/matt/weather-redbank/.venv/bin/python /home/matt/weather-redbank/collect.py
TimeoutStartSec=300
